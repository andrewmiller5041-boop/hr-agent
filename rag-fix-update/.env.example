# Copy this file to .env and fill in real values. Never commit .env.

# Groq API key (free tier). Get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use for the agent's tool-calling chat completions.
GROQ_MODEL=llama-3.3-70b-versatile

# Local embedding model (all-MiniLM-L6-v2, downloaded once on first run via
# onnxruntime -- no API key needed).
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2 (onnxruntime, local)

# Paths (defaults are fine for local dev and for the single-service Render deploy).
CORPUS_DIR=corpus
MOCK_DATA_DIR=mock_data
VECTOR_STORE_DIR=app/rag/store

# RAG retrieval settings.
RETRIEVAL_TOP_K=4
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=60

# MCP transport: "memory" (default, one process total -- recommended for
# free-tier RAM limits) or "stdio" (spawns mcp_server/server.py as a real
# separate OS process, useful for local debugging).
MCP_TRANSPORT=memory
MCP_SERVER_CMD=python
MCP_SERVER_SCRIPT=mcp_server/server.py
